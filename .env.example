# ── Supabase ────────────────────────────────────────────────
# Public (safe for the browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-only (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Integrations (server-only) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

RESEND_API_KEY=
# The sender every email goes out from; its domain must be verified in Resend.
EMAIL_FROM=Studio AutoPilot <noreply@yourdomain.in>
# The web app's address: links in emails (terms, invoices, invites) start with it.
APP_URL=https://app.yourdomain.in

# ── Jobs ────────────────────────────────────────────────────
# Shared secret cron endpoints check with constant-time comparison
CRON_SECRET=

# ── Sentry (the web build reads these) ──────────────────────
# Browser DSN. Public by design: it ships in the bundle and can only submit
# events to its own project. Empty = Sentry off in the browser.
VITE_SENTRY_DSN=
# Must match the API's APP_VERSION or the two report different releases.
VITE_APP_VERSION=
VITE_ENVIRONMENT=development
# 0 drops Session Replay from the bundle (~40 kB gzip). Anything else keeps it.
VITE_SENTRY_REPLAY=

# Source-map upload, BUILD TIME ONLY — belongs in CI secrets, never on the VPS
# and never in a running app. Use an ORGANIZATION auth token (Settings → Auth
# Tokens at the org level, scopes project:releases + org:read), not a personal
# one: a personal token carries one human's access and dies with their account.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
